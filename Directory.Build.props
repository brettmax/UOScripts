<?xml version="1.0" encoding="utf-8"?>
<Project>
    <!--
      Applies to Scripts/** in this repository only. MSBuild imports the nearest
      Directory.Build.props walking up from each project, so the ModernUO and
      ModernSpawner submodules keep their own build settings.
    -->
    <PropertyGroup>
        <Authors>Kamron Batman</Authors>
        <Company>ModernUO</Company>
        <Copyright>2021-2026</Copyright>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <Configurations>Debug;Release</Configurations>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsAsErrors />
        <NoWarn>NU1603</NoWarn>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants>MUO</DefineConstants>
        <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
        <ModernUORoot Condition="'$(ModernUORoot)'==''">$(MSBuildThisFileDirectory)ModernUO/</ModernUORoot>
        <!-- Script assemblies build next to UOContent.dll so the server loads them from assemblies.json. -->
        <ScriptsAssemblyDir>$(ModernUORoot)Distribution/Assemblies/</ScriptsAssemblyDir>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <DefineConstants>$(DefineConstants);TRACE;DEBUG</DefineConstants>
        <Optimize>false</Optimize>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <Optimize>true</Optimize>
    </PropertyGroup>
</Project>
